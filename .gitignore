hyvideo/utils/rewrite/i2v_env.sh

# EmoReward reward sub-packages: code is fetched by scripts/setup_reward_subpackages.sh
# and weights by REWARD_SUBPACKAGES.md — never track them in this repo (keeps it clean
# and prevents accidentally staging multi-GB provider weights). Matches both the dev-tree
# module name (mind_the_muscle) and the open-source name (emo_reward).
hyvideo/models/reward_models/*/CLIP-AUTT/
hyvideo/models/reward_models/*/R1-Omni/
hyvideo/models/reward_models/*/OpenFace-3.0/
hyvideo/models/reward_models/*/facial-landmarks-recognition/
# Curated website media referenced by the README and visual-results gallery.
!assets/Visual_Results/*.mp4
!assets/Visual_Results/*.jpg
!assets/Visual_Results/*.png
